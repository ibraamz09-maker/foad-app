# Session secret (générer avec: openssl rand -hex 32)
SESSION_SECRET=your-super-secret-key-min-32-chars-here-change-this

# Turso database (https://turso.tech — gratuit)
TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Google OAuth2 (depuis Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URL de l'application (changer après déploiement Vercel)
NEXT_PUBLIC_APP_URL=https://votre-app.vercel.app
